<Border x:Class="PCL.MyButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FocusVisualStyle="{StaticResource Fluent.Focus}" x:Name="PanBack"
        AutomationProperties.Name="{Binding Text, ElementName=PanBack}" Focusable="True" MinHeight="40" UseLayoutRounding="False" SnapsToDevicePixels="False"
        Background="{StaticResource ColorBrushSemiTransparent}"
    xmlns:glass="clr-namespace:PCL.Core.UI.Controls;assembly=PCL.Core">
    <glass:LiquidGlassSurface Material="Action" CornerRadius="{StaticResource Fluent.ButtonRadius}" x:Name="PanFore" BorderThickness="0" BorderBrush="{DynamicResource Fluent.Stroke}"
            RenderTransformOrigin="0.5,0.5" Background="{DynamicResource Fluent.GlassSurface}">
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
        <TextBlock TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" TextTrimming="None"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" x:Name="LabText" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5"
                   Foreground="{DynamicResource ColorBrush1}" FontSize="13"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <ScaleTransform />
            </TextBlock.RenderTransform>
        </TextBlock>
    </glass:LiquidGlassSurface>
</Border>
