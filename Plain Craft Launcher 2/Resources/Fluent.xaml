<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="Fluent.TitleBar">White</SolidColorBrush>
    <SolidColorBrush x:Key="Fluent.NavigationHover">#4CFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Fluent.NavigationPressed">#70FFFFFF</SolidColorBrush>
    <sys:Boolean x:Key="LiquidGlass.Enabled">True</sys:Boolean>
    <sys:Double x:Key="LiquidGlass.BlurRadius">12</sys:Double>
    <KernelType x:Key="LiquidGlass.BlurKernelType">Gaussian</KernelType>
    <SolidColorBrush x:Key="LiquidGlass.Fallback">#F4F7FC</SolidColorBrush>
    <LinearGradientBrush x:Key="LiquidGlass.Backdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CCE2F4" Offset="0" />
        <GradientStop Color="#E7DEF6" Offset="0.48" />
        <GradientStop Color="#D8EFEB" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="Fluent.ButtonRadius">16</CornerRadius>
    <CornerRadius x:Key="Fluent.CardRadius">20</CornerRadius>
    <CornerRadius x:Key="Fluent.DialogRadius">24</CornerRadius>
    <Thickness x:Key="Fluent.PagePadding">24,16,24,20</Thickness>
    <sys:Double x:Key="Fluent.BlurRadius">18</sys:Double>
    <SolidColorBrush x:Key="Fluent.OnAccent">#FFFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Fluent.Surface">#7AFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Fluent.Card">#7AFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Fluent.Stroke">#22000000</SolidColorBrush>
    <SolidColorBrush x:Key="Fluent.GlassSurface">#33FFFFFF</SolidColorBrush>
    <Style x:Key="Fluent.Focus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource ColorBrush3}" BorderThickness="2"
                            CornerRadius="16" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- macOS-style traffic lights: small visual circles, generous pointer targets. -->
    <Style x:Key="Fluent.TrafficLight" TargetType="Button">
        <!-- 13px circles with 10.4px gaps (20% less than the former 13px). -->
        <Setter Property="Width" Value="23.4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="#FF5F57" />
        <Setter Property="Foreground" Value="#68000000" />
        <Setter Property="BorderBrush" Value="#22000000" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Fluent.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Light" Width="13" Height="13" Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}" StrokeThickness="0.7" />
                        <ContentPresenter x:Name="Glyph" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Light" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter TargetName="Light" Property="Fill" Value="#FF9E9EA3" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Fluent.DockButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Fluent.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="22" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
