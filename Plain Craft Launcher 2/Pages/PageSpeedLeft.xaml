<local:MyPageLeft x:Class="PCL.PageSpeedLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d"
                  d:DesignHeight="450" HorizontalAlignment="Stretch"
    xmlns:glass="clr-namespace:PCL.Core.UI.Controls;assembly=PCL.Core">
    <Grid.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock" x:Key="Split">
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Height" Value="2" />
                <Setter Property="Margin" Value="25,7" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                            <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="0" />
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.02" />
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.98" />
                            <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Grid.Resources>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <glass:LiquidGlassSurface Material="Content" Grid.Column="0" Background="{DynamicResource Fluent.Card}" CornerRadius="16" Padding="16" Margin="4">
        <StackPanel><TextBlock Text="{DynamicResource Speed.Progress.Total}" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12"/>
        <TextBlock x:Name="LabProgress" Text="0 %" FontSize="22" Margin="0,6,0,0"/></StackPanel>
    </glass:LiquidGlassSurface>
    <glass:LiquidGlassSurface Material="Content" Grid.Column="1" Background="{DynamicResource Fluent.Card}" CornerRadius="16" Padding="16" Margin="4">
        <StackPanel><TextBlock Text="{DynamicResource Speed.Progress.Speed}" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12"/>
        <TextBlock x:Name="LabSpeed" Text="0 B/s" FontSize="22" Margin="0,6,0,0"/></StackPanel>
    </glass:LiquidGlassSurface>
    <glass:LiquidGlassSurface Material="Content" Grid.Column="2" Background="{DynamicResource Fluent.Card}" CornerRadius="16" Padding="16" Margin="4">
        <StackPanel><TextBlock Text="{DynamicResource Speed.Progress.RemainingFiles}" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12"/>
        <TextBlock x:Name="LabFile" Text="0" FontSize="22" Margin="0,6,0,0"/></StackPanel>
    </glass:LiquidGlassSurface>
    <glass:LiquidGlassSurface Material="Content" Grid.Column="3" Background="{DynamicResource Fluent.Card}" CornerRadius="16" Padding="16" Margin="4">
        <StackPanel><TextBlock Text="{DynamicResource Speed.Progress.RemainingThreads}" Foreground="{DynamicResource ColorBrushGray2}" FontSize="12"/>
        <TextBlock x:Name="LabThread" Text="0" FontSize="22" Margin="0,6,0,0"/></StackPanel>
    </glass:LiquidGlassSurface>
</local:MyPageLeft>
