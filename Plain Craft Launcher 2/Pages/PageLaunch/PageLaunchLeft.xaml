<local:MyPageLeft x:Class="PCL.PageLaunchLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d" x:Name="PanBack"
                  d:DesignHeight="148"
                  xmlns:glass="clr-namespace:PCL.Core.UI.Controls;assembly=PCL.Core">
    <Grid Name="PanInput" RenderTransformOrigin="0.5,0.5" MinHeight="148" MaxWidth="1120"
          SizeChanged="PanInput_SizeChanged">
        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
        <glass:LiquidGlassSurface Material="Chrome" CornerRadius="{StaticResource Fluent.DialogRadius}"
                Background="{DynamicResource Fluent.Card}" BorderBrush="{DynamicResource Fluent.Stroke}" BorderThickness="1">
            <Grid>
                <Grid Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 账号：整块可点，悬浮时铺一层材质遮罩，按下时轻微下沉 -->
                    <Button x:Name="BtnHomeAccount" Grid.Column="0" Click="HomeAccount_Click"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource Main.Fluent.Account}"
                            AutomationProperties.Name="{DynamicResource Main.Fluent.Account}"
                            FocusVisualStyle="{StaticResource Fluent.Focus}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid x:Name="AccountChip" Width="200" Height="64" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                            <Border x:Name="AccountHoverMask" CornerRadius="{StaticResource Fluent.ButtonRadius}"
                                    Background="{DynamicResource Fluent.ActionHover}" Opacity="0" IsHitTestVisible="False" />
                            <Grid Margin="8,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="56" Height="56" VerticalAlignment="Center">
                                    <Border CornerRadius="16" Background="{DynamicResource Fluent.GlassSurface}"
                                            BorderBrush="{DynamicResource Fluent.Stroke}" BorderThickness="1" />
                                    <TextBlock x:Name="HomeAvatarFallback" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray2}" />
                                    <Image x:Name="HomeSkinBack" Width="38" Height="38" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <Image x:Name="HomeSkinFore" Width="44" Height="44" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                                <TextBlock x:Name="HomePlayerName" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Grid>
                        </Grid>
                    </Button>

                    <!-- 实例身份：页面唯一的展示级文字 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Main.Fluent.PlayEyebrow}" FontSize="12" LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ColorBrushGray2}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                        <TextBlock x:Name="LabVersion" Text="{DynamicResource Launch.Home.VersionList.Loading}"
                                   FontSize="30" LineHeight="36" LineStackingStrategy="BlockLineHeight"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="72"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <WrapPanel Margin="0,12,0,0">
                            <local:MyButton x:Name="BtnInstance" Height="40" Margin="0,0,8,0"
                                            Text="{DynamicResource Launch.Home.SelectInstance}" IsEnabled="False" />
                            <local:MyButton x:Name="BtnMore" Visibility="Collapsed" Height="40"
                                            Text="{DynamicResource Launch.Home.InstanceSettings}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- 启动：页面唯一的饱和色块 -->
                    <Grid x:Name="LaunchAction" Grid.Column="4" Width="208" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="AprilScaleTrans" />
                                <TranslateTransform x:Name="AprilPosTrans" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <local:MyButton x:Name="BtnLaunch" Height="52" HorizontalAlignment="Stretch"
                                        Text="{DynamicResource Launch.Home.Button.Loading}" ColorType="Highlight" IsEnabled="False" />
                        <Border x:Name="LaunchHoverMask" CornerRadius="{StaticResource Fluent.ButtonRadius}"
                                Background="{DynamicResource Fluent.ActionHover}" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </Grid>

                <!-- 材质高光：浅色下是极淡的顶缘，深色下是受光边 -->
                <Border Height="1" VerticalAlignment="Top" Margin="24,1,24,0" IsHitTestVisible="False" Opacity="0.28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="{DynamicResource ColorObject1}" Offset="0.5" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </glass:LiquidGlassSurface>
    </Grid>

    <Popup x:Name="AccountPopup" Placement="Center" PlacementTarget="{Binding ElementName=PanInput}"
           AllowsTransparency="True" StaysOpen="False" PopupAnimation="None"
           Opened="AccountPopup_Opened" Closed="AccountPopup_Closed">
        <glass:LiquidGlassSurface x:Name="AccountFlyout" Material="Floating" Background="{DynamicResource Fluent.Surface}"
                BorderBrush="{DynamicResource Fluent.Stroke}" BorderThickness="1" CornerRadius="24" Padding="24" Width="350" MaxHeight="360"
                glass:LiquidGlassSurface.UseLightweightMaterial="False" Opacity="0" RenderTransformOrigin="1,0">
            <glass:LiquidGlassSurface.RenderTransform>
                <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
            </glass:LiquidGlassSurface.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Main.Fluent.Account}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,18" />
                    <Grid x:Name="PanLogin" />
                </StackPanel>
            </ScrollViewer>
        </glass:LiquidGlassSurface>
    </Popup>

    <Grid Name="PanLaunching" MinHeight="190" MaxWidth="1120" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Opacity="0">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <glass:LiquidGlassSurface Grid.RowSpan="5" Material="Chrome" CornerRadius="{StaticResource Fluent.DialogRadius}"
                Background="{DynamicResource Fluent.Card}" BorderBrush="{DynamicResource Fluent.Stroke}" BorderThickness="1"
                IsHitTestVisible="False" />
        <StackPanel Grid.Row="1" RenderTransformOrigin="0.5,0.5" Margin="0,-7,0,0">
            <local:MyLoading x:Name="LoadLaunching" AutoRun="False" Height="50" Margin="0,10,0,5" />
            <TextBlock Name="LabLaunchingTitle" Margin="15,10,15,0" Text="{DynamicResource Launch.Status.Title.Launching}" HorizontalAlignment="Center"
                       FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
            <TextBlock Name="LabLaunchingName" Margin="40,5,40,0" FontSize="13.5" Text="Forge 1.12.2-15.8.0.1560"
                       HorizontalAlignment="Center" Foreground="{DynamicResource ColorBrushGray2}" />
            <Grid Height="4" Margin="30,12,30,27" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="ProgressLaunchingFinished" Width="69.28*" />
                    <ColumnDefinition Name="ProgressLaunchingUnfinished" Width="30.72*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                            <GradientStop Color="{DynamicResource ColorObject4}" Offset="0" />
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.6" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrush6}" Opacity="0.6" />
            </Grid>
            <Grid HorizontalAlignment="Center" Name="PanLaunchingInfo" SizeChanged="PanLaunchingInfo_SizeChangedW">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{DynamicResource Launch.Status.CurrentStep}" Grid.Row="0" Grid.Column="1"
                           HorizontalAlignment="Right" Opacity="0.5" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{DynamicResource Launch.Status.DownloadLibs}" Grid.Row="0" Grid.Column="3"
                           HorizontalAlignment="Left" Name="LabLaunchingStage" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{DynamicResource Launch.Status.LoginMethod}" Grid.Row="1" Grid.Column="1"
                           HorizontalAlignment="Right" Opacity="0.5" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{DynamicResource Launch.Status.MicrosoftLogin}" Grid.Row="1" Grid.Column="3"
                           HorizontalAlignment="Left" MaxWidth="160" TextWrapping="WrapWithOverflow"
                           Name="LabLaunchingMethod" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{DynamicResource Launch.Status.LaunchProgress}" Grid.Row="2" Grid.Column="1"
                           HorizontalAlignment="Right" Opacity="0.5" Name="LabLaunchingProgressLeft" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="69.28 %" Grid.Row="2" Grid.Column="3"
                           HorizontalAlignment="Left" Name="LabLaunchingProgress" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="{DynamicResource Launch.Status.DownloadSpeed}" Grid.Row="3" Grid.Column="1"
                           HorizontalAlignment="Right" Opacity="0" Name="LabLaunchingDownloadLeft"
                           Visibility="Collapsed" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="5.2 M/s" Grid.Row="3" Grid.Column="3"
                           HorizontalAlignment="Left" Name="LabLaunchingDownload" Opacity="0" Visibility="Collapsed" />
                <Grid x:Name="PanLaunchingHint" HorizontalAlignment="Center" Grid.Row="2" Grid.ColumnSpan="5"
                      Grid.RowSpan="2" Width="260" Visibility="Collapsed" Margin="0,16,0,2" Opacity="0">
                    <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="3"
                            BorderBrush="{DynamicResource ColorBrushGray1}" Opacity="0.5">
                        <Border.Clip>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0,0,1000,1000" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <RectangleGeometry Rect="94,0,72,10" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Border.Clip>
                    </Border>
                    <TextBlock FontSize="12.5" Text="{DynamicResource Launch.Status.Trivia}" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Opacity="0.5" />
                    <TextBlock x:Name="LabLaunchingHint" FontSize="12.5" Text="{DynamicResource Launch.Status.Trivia.Placeholder}"
                               Margin="11,21,11,10" TextWrapping="Wrap" HorizontalAlignment="Center" MaxHeight="54"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </StackPanel>
        <local:MyButton Grid.Row="4" x:Name="BtnCancel" Height="40" Margin="20,0,20,20" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Click="BtnCancel_Click" Padding="20,0"
                        Text="{DynamicResource Common.Action.Cancel}" />
    </Grid>
</local:MyPageLeft>
