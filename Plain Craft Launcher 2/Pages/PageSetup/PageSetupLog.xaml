<local:MyPageRight x:Class="PCL.PageSetupLog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:PCL"
                   mc:Ignorable="d"
                   d:DesignHeight="450" d:DesignWidth="800"
                   PanScroll="{Binding ElementName=PanBack}" RenderOptions.BitmapScalingMode="LowQuality">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <local:MyScrollViewer.FixedHeader>
<local:MyCard Title="{DynamicResource Setup.Log.Operations}" Margin="16,8,16,8">
                <WrapPanel Margin="25,40,20,12">
                    <local:MyButton Text="{DynamicResource Setup.Log.Export}" ColorType="Highlight" Margin="0,0,15,8"
                                    Click="ButtonExport_OnClick" />
                    <local:MyButton Text="{DynamicResource Setup.Log.ExportAll}" ColorType="Normal" Margin="0,0,15,8"
                                    Click="ButtonExportAll_OnClick" />
                    <local:MyButton Text="{DynamicResource Setup.Log.OpenDirectory}" ColorType="Normal" Margin="0,0,15,8"
                                    Click="ButtonOpenDir_OnClick" />
                    <local:MyButton Text="{DynamicResource Setup.Log.ClearHistory}" ColorType="Red" Margin="0,0,0,8" Click="ButtonClean_OnClick" />
                </WrapPanel>
            </local:MyCard>
        </local:MyScrollViewer.FixedHeader>
        <DockPanel>

            <local:MyCard Title="{DynamicResource Setup.Log.AllLogs}" Margin="16,0,16,16" x:Name="PanContent">
                <StackPanel Name="PanList" Orientation="Vertical" Margin="20,36,18,18" />
            </local:MyCard>
        </DockPanel>

    </local:MyScrollViewer>
</local:MyPageRight>
