<local:MyPageLeft x:Class="PCL.PageToolsLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d">
    <local:MyScrollViewer Style="{StaticResource Fluent.CategoryScroll}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="PanItem" Margin="0,4,0,4" Orientation="Vertical">


        <TextBlock Text="{DynamicResource Tools.Left.Utilities}" Margin="13,5,5,3" Opacity="0.8" FontSize="13"
                   x:Name="TextToolsCategory" />
        <local:MyListItem IsNavigationChip="True" Margin="3,0" x:Name="ItemTest"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="3"
                          MinPaddingRight="8" MinHeight="40"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Tools.Left.Utilities.Title}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/tool-case" />

    </StackPanel>
    </local:MyScrollViewer>
</local:MyPageLeft>
